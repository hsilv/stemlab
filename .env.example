# Optional host port for Docker Compose:
STEMLAB_PORT=8000
# Used when running Python processes on the host (Compose sets its own URLs):
STEMLAB_BROKER_URL=redis://localhost:6379/0
STEMLAB_RESULT_BACKEND=redis://localhost:6379/1
STEMLAB_DATA_DIR=data
# Mixxx library used to offer its hot cues (default shown):
# STEMLAB_MIXXX_DB=/home/you/.mixxx/mixxxdb.sqlite
STEMLAB_DEVICE=auto
STEMLAB_MAX_UPLOAD_MB=200
STEMLAB_MAX_DURATION_SECONDS=900
STEMLAB_JOB_TIMEOUT_SECONDS=7200
STEMLAB_CPU_THREADS=4
STEMLAB_MODEL=htdemucs_ft
STEMLAB_VOCALS=ensemble
STEMLAB_INSTRUMENTS_FROM=residual
STEMLAB_SHIFTS=2
STEMLAB_OVERLAP=0.5
